# Copy to .env.local for development; set these in Vercel → Project Settings → Environment Variables for production.

# Public site URL — used in metadata, sitemaps, etc.
# Local dev:  http://localhost:3000
# Production: https://lumemaison.com
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Admin panel credentials (used by app/api/admin/auth/route.ts)
ADMIN_USERNAME=manzura
ADMIN_PASSWORD=change-me

# iron-session encryption secret (used by lib/session.ts)
# Generate a fresh 64-char hex string for production: openssl rand -hex 32
SESSION_SECRET=change-me-to-a-64-character-hex-string-from-openssl-rand-hex-32

# Supabase — customer accounts + orders (Phase 1+).
# Create a project at https://supabase.com (free tier), copy values from
# Project Settings → API. The service role key is server-side only; never
# expose it to the browser.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR-ANON-KEY
SUPABASE_SERVICE_ROLE_KEY=YOUR-SERVICE-ROLE-KEY

# Checkout payment details — shown on /checkout/payment.
# Leave any value empty to hide that line/section from the UI; never expose
# a placeholder so customers don't transfer to a wrong destination.

# Wise (bank transfer) recipient details — full label set shown on the page.
WISE_ACCOUNT_NAME=
WISE_BANK_NAME=
WISE_ACCOUNT_NUMBER=
WISE_SWIFT=
WISE_ADDRESS=
WISE_CITY=
WISE_COUNTRY=
WISE_POSTCODE=
WISE_CURRENCY=

# USDT — one row per network. Only networks whose address is set are shown
# on the page. Sending on a network not listed here loses funds.
USDT_ERC20_ADDRESS=
USDT_TRC20_ADDRESS=

# WhatsApp contact for USDT payment confirmation (international format, e.g. +82 10-1234-5678).
PAYMENT_WHATSAPP=

# Where the customer is told to email their payment screenshot, and where
# the Phase 3 admin email notification will be sent.
ADMIN_NOTIFICATION_EMAIL=manzura@example.com

# Transactional email — Namecheap Private Email SMTP (Nodemailer).
# Mailbox: info@lumeemaison.com (Namecheap Private Email plan).
# - SMTP_HOST/PORT come from Namecheap (port 465 = implicit TLS).
# - SMTP_FROM should be a display-name + the mailbox so DMARC/SPF align.
# - SMTP_PASS is the mailbox password (set in Namecheap → Private Email).
SMTP_HOST=mail.privateemail.com
SMTP_PORT=465
SMTP_USER=info@lumeemaison.com
SMTP_PASS=change-me
SMTP_FROM=Lumée Maison <info@lumeemaison.com>
