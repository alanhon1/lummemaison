# Copy to .env.local for development; set these in Vercel → Project Settings → Environment Variables for production.

# Public site URL — used in metadata, sitemaps, etc.
# Local dev:  http://localhost:3000
# Production: https://lumemaison.com
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Admin panel credentials (used by app/api/admin/auth/route.ts)
ADMIN_USERNAME=manzura
ADMIN_PASSWORD=change-me

# iron-session encryption secret (used by lib/session.ts)
# Generate a fresh 64-char hex string for production: openssl rand -hex 32
SESSION_SECRET=change-me-to-a-64-character-hex-string-from-openssl-rand-hex-32

# Supabase — customer accounts + orders (Phase 1+).
# Create a project at https://supabase.com (free tier), copy values from
# Project Settings → API. The service role key is server-side only; never
# expose it to the browser.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR-ANON-KEY
SUPABASE_SERVICE_ROLE_KEY=YOUR-SERVICE-ROLE-KEY

# Checkout payment details — shown on /checkout/payment.
# Leave placeholder values for now; Manzura will replace once layout is approved.
WISE_ACCOUNT_NAME=[Account name pending]
WISE_BANK_NAME=[Bank name pending]
WISE_ACCOUNT_NUMBER=[Account number pending]
WISE_SWIFT=[SWIFT/Routing pending]
USDT_WALLET_ADDRESS=[Wallet address pending]

# Where the customer is told to email their payment screenshot, and where
# the Phase 3 admin email notification will be sent.
ADMIN_NOTIFICATION_EMAIL=manzura@example.com
